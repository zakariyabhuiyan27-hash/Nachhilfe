{
  // Lernwelt für Rafi und Ibrahim – Cloudflare Worker mit statischen Dateien und D1-Datenbank
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lernwelt",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lernwelt-db",
      "database_id": "01ed8ea4-f84a-4f17-acd4-7125da8a7386"
    }
  ],
  "observability": { "enabled": true }
}
